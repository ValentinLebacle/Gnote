public class EnseignantController {

    @FXML
    private TextField nomField;

    @FXML
    private TextField emailField;

    @FXML
    private TextField specialiteField;

    @FXML
    private PasswordField passwordField;

    @FXML
    private ComboBox<String> roleComboBox;

    @FXML
    private Button creerButton;

    @FXML
    private Button logoutButton; // Bouton de déconnexion ajouté

    @FXML
    private void initialize() {
        // Ajoute les rôles dans la liste déroulante
        roleComboBox.setItems(FXCollections.observableArrayList("Enseignant", "Admin"));
        roleComboBox.setValue("Enseignant"); // Valeur par défaut
    }

    @FXML
    private void handleCreerEnseignant() {
        String nom = nomField.getText();
        String email = emailField.getText();
        String specialite = specialiteField.getText();
        String password = passwordField.getText();
        String role = roleComboBox.getValue();

        if (nom.isEmpty() || email.isEmpty() || specialite.isEmpty() || password.isEmpty()) {
            showAlert("Erreur", "Tous les champs doivent être remplis.");
            return;
        }

        int roleId = role.equals("Admin") ? 3 : 2; // Mapping vers role_id

        try (Connection connection = DatabaseConfig.getConnection()) {
            String sql = "INSERT INTO Enseignants (nom, email, specialite, mot_de_passe, role_id) VALUES (?, ?, ?, ?, ?)";
            PreparedStatement statement = connection.prepareStatement(sql);

            statement.setString(1, nom);
            statement.setString(2, email);
            statement.setString(3, specialite);
            statement.setString(4, password);
            statement.setInt(5, roleId);

            statement.executeUpdate();
            showAlert("Succès", "Enseignant ajouté avec succès !");
            
            // Fermer la fenêtre après ajout
            Stage stage = (Stage) creerButton.getScene().getWindow();
            stage.close();

        } catch (SQLException e) {
            e.printStackTrace();
            showAlert("Erreur", "Impossible d'ajouter l'enseignant.");
        }
    }

