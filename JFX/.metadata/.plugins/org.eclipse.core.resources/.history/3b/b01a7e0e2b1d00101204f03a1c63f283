package org.openjfx.sio2E4.controller;

import javafx.fxml.FXML;
import javafx.scene.control.*;
import javafx.beans.property.SimpleStringProperty;
import javafx.application.Platform;
import org.openjfx.sio2E4.model.Matiere;
import org.openjfx.sio2E4.service.AuthService;

import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.util.Arrays;
import java.util.List;
import com.fasterxml.jackson.databind.ObjectMapper;

public class MatieresController {

    @FXML
    private TableView<Matiere> matieresTable;

    @FXML
    private TableColumn<Matiere, String> libelleColumn;

    @FXML
    private TextField libelleField;

    @FXML
    private Label statusLabel;

    private final String API_URL = "http://localhost:8080/api/matieres";
    private final String BEARER_TOKEN = "Bearer " + AuthService.getToken();

    @FXML
    public void initialize() {
        libelleColumn.setCellValueFactory(data -> new SimpleStringProperty(data.getValue().getLibelle()));
        libelleColumn.setCellFactory(TextFieldTableCell.forTableColumn());

        libelleColumn.setOnEditCommit(event -> handleEditMatiere(event));
        fetchMatieres(); // Charger les matières au démarrage de la page
    }

    // Charger les matières depuis l'API
    private void fetchMatieres() {
        HttpClient client = HttpClient.newHttpClient();
        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(API_URL))
                .header("Authorization", BEARER_TOKEN)
                .GET()
                .build();

        client.sendAsync(request, HttpResponse.BodyHandlers.ofString())
                .thenApply(HttpResponse::body)
                .thenAccept(this::parseMatieres)
                .exceptionally(e -> {
                    e.printStackTrace();
                    return null;
                });
    }

    private void parseMatieres(String responseBody) {
        ObjectMapper mapper = new ObjectMapper();
        try {
            List<Matiere> matieres = Arrays.asList(mapper.readValue(responseBody, Matiere[].class));
            Platform.runLater(() -> matieresTable.getItems().setAll(matieres));
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // Ajouter une nouvelle matière
    @FXML
    public void handleAddMatiere() {
        String libelle = libelleField.getText();
        if (libelle.isEmpty()) {
            statusLabel.setText("Veuillez entrer un libellé.");
            return;
        }

        Matiere newMatiere = new Matiere(libelle);
        sendPostRequest(newMatiere); // Envoi de la requête POST pour ajouter la matière
    }

    // Modifier une matière
    @FXML
    public void handleEditMatiere(TableColumn.CellEditEvent<Matiere, String> event) {
        Matiere selectedMatiere = event.getRowValue();
        selectedMatiere.setLibelle(event.getNewValue());
        sendPutRequest(selectedMatiere); // Envoi de la requête PUT pour modifier la matière
    }

    // Supprimer une matière
    @FXML
    public void handleDeleteMatiere() {
        Matiere selectedMatiere = matieresTable.getSelectionModel().getSelectedItem();
        if (selectedMatiere != null) {
            sendDeleteRequest(selectedMatiere.getId()); // Envoi de la requête DELETE pour supprimer la matière
        } else {
            statusLabel.setText("Veuillez sélectionner une matière à supprimer.");
        }
    }

    // Envoi de la requête POST pour ajouter une matière
    private void sendPostRequest(Matiere matiere) {
        HttpClient client = HttpClient.newHttpClient();
        String json = "{\"libelle\": \"" + matiere.getLibelle() + "\"}";

        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(API_URL))
                .header("Authorization", BEARER_TOKEN)
                .header("Content-Type", "application/json")
                .POST(HttpRequest.BodyPublishers.ofString(json))
                .build();

        client.sendAsync(request, HttpResponse.BodyHandlers.ofString())
                .thenAccept(response -> {
                    fetchMatieres();  // Rafraîchir la liste après ajout
                    Platform.runLater(() -> statusLabel.setText("Matière ajoutée avec succès."));
                })
                .exceptionally(e -> {
                    e.printStackTrace();
                    return null;
                });
    }

    // Envoi de la requête PUT pour modifier une matière
    private void sendPutRequest(Matiere matiere) {
        HttpClient client = HttpClient.newHttpClient();
        String json = "{\"id\": " + matiere.getId() + ", \"libelle\": \"" + matiere.getLibelle() + "\"}";

        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(API_URL + "/" + matiere.getId()))
                .header("Authorization", BEARER_TOKEN)
                .header("Content-Type", "application/json")
                .PUT(HttpRequest.BodyPublishers.ofString(json))
                .build();

        client.sendAsync(request, HttpResponse.BodyHandlers.ofString())
                .thenAccept(response -> {
                    fetchMatieres();  // Rafraîchir la liste après modification
                    Platform.runLater(() -> statusLabel.setText("Matière modifiée avec succès."));
                })
                .exceptionally(e -> {
                    e.printStackTrace();
                    return null;
                });
    }

    // Envoi de la requête DELETE pour supprimer une matière
    private void sendDeleteRequest(int matiereId) {
        HttpClient client = HttpClient.newHttpClient();
        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(API_URL + "/" + matiereId))
                .header("Authorization", BEARER_TOKEN)
                .DELETE()
                .build();

        client.sendAsync(request, HttpResponse.BodyHandlers.ofString())
                .thenAccept(response -> {
                    fetchMatieres();  // Rafraîchir la liste après suppression
                    Platform.runLater(() -> statusLabel.setText("Matière supprimée."));
                })
                .exceptionally(e -> {
                    e.printStackTrace();
                    return null;
                });
    }
}
